+import copy
+from pathlib import Path
+import tempfile
+import unittest
+
+from queue_store import Queue
+
+
+class QueueOwnerRegressionTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.path = Path(self.temp.name) / "jobs.json"
+        self.q = Queue(self.path)
+        self.assertTrue(self.q.enqueue("job"))
+
+    def assert_rejected_completion_preserves_state(self, owner):
+        before_memory = copy.deepcopy(self.q.jobs)
+        before_disk = self.path.read_bytes()
+        self.assertFalse(self.q.complete("job", owner, "rejected-result"))
+        self.assertEqual(self.q.jobs, before_memory)
+        self.assertEqual(self.path.read_bytes(), before_disk)
+        self.assertEqual(Queue(self.path).jobs, before_memory)
+
+    def test_reclaimed_owner_rejected_then_current_owner_persists(self):
+        self.assertTrue(self.q.claim("job", "worker-A", 0, lease=10))
+        self.assertTrue(self.q.claim("job", "worker-B", 10, lease=10))
+        self.assert_rejected_completion_preserves_state("worker-A")
+        self.assertTrue(self.q.complete("job", "worker-B", "fresh"))
+        restarted = Queue(self.path)
+        self.assertEqual(restarted.jobs, self.q.jobs)
+        self.assertEqual(restarted.jobs["job"]["state"], "done")
+        self.assertEqual(restarted.jobs["job"]["result"], "fresh")
+
+    def test_unrelated_owner_rejected_during_active_lease(self):
+        self.assertTrue(self.q.claim("job", "worker-A", 10, lease=30))
+        self.assert_rejected_completion_preserves_state("unrelated-worker")
+        self.assertTrue(self.q.complete("job", "worker-A", "correct"))
+        self.assertEqual(Queue(self.path).jobs["job"]["result"], "correct")
+
+    def test_pending_and_done_completion_do_not_mutate_state(self):
+        self.assert_rejected_completion_preserves_state("worker-A")
+        self.assertTrue(self.q.claim("job", "worker-A", 0))
+        self.assertTrue(self.q.complete("job", "worker-A", "correct"))
+        self.assert_rejected_completion_preserves_state("worker-A")
+
+    def test_duplicate_enqueue_preserves_running_and_completed_job(self):
+        self.assertTrue(self.q.claim("job", "worker-A", 0))
+        for state in ("leased", "done"):
+            with self.subTest(state=state):
+                before_memory = copy.deepcopy(self.q.jobs)
+                before_disk = self.path.read_bytes()
+                self.assertFalse(self.q.enqueue("job"))
+                self.assertEqual(self.q.jobs, before_memory)
+                self.assertEqual(self.path.read_bytes(), before_disk)
+                self.assertEqual(Queue(self.path).jobs, before_memory)
+            if state == "leased":
+                self.assertTrue(self.q.complete("job", "worker-A", "correct"))
+
+
+if __name__ == "__main__":
+    unittest.main()
